{
  "name": "playwright-qa-portfolio",
  "version": "1.0.0",
  "description": "Portfolio de automacao Web UI e API contra o QuickPizza da Grafana com Playwright e TypeScript.",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "quickpizza:local": "docker run --rm -p 3333:3333 ghcr.io/grafana/quickpizza-local:latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
